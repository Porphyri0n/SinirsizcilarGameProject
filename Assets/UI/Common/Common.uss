:root {
    --color-bg-dark: rgba(20, 20, 20, 0.85);
    --color-accent: #ffcc00;
    --color-health: #e63946;
    --color-energy: #457b9d;
    --color-text: #f1faee;
    --spacing-sm: 4px;
    --spacing-md: 8px;
    --spacing-lg: 16px;
    --panel-radius: 8px;
}

.panel {
    background-color: var(--color-bg-dark);
    border-radius: var(--panel-radius);
    padding: var(--spacing-md);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
}

.label {
    color: var(--color-text);
    -unity-font-style: bold;
}

.progress-bar-container {
    height: 20px;
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: var(--spacing-sm);
}

.progress-bar-fill {
    height: 100%;
    width: 100%;
}

.hp-fill {
    background-color: var(--color-health);
}

.energy-fill {
    background-color: var(--color-energy);
}
