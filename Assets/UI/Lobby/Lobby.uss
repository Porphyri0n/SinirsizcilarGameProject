2026-05-31 AI-Tag
This was created with the help of Assistant, a Unity Artificial Intelligence product.
*/
.root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.background {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(20, 23, 31, 0.98);
}

.panel {
    width: 450px;
    background-color: rgba(30, 35, 45, 1);
    border-radius: 12px;
    padding: 25px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
}

.header-text {
    font-size: 28px;
    -unity-font-style: bold;
    color: white;
    margin-bottom: 5px;
    -unity-text-align: middle-center;
}

.subtitle-text {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 20px;
    -unity-text-align: middle-center;
}

.info-text {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 15px;
    -unity-text-align: middle-center;
}

.spacer {
    height: 15px;
}

.input-field {
    margin-bottom: 10px;
}

.unity-text-field__input {
    background-color: rgba(0, 0, 0, 0.2);
    border-color: rgba(255, 255, 255, 0.1);
    color: white;
    padding: 8px;
    border-radius: 4px;
}

.button {
    background-color: rgba(60, 100, 240, 1);
    color: white;
    padding: 10px;
    border-radius: 6px;
    border-width: 0;
    margin-bottom: 8px;
    -unity-font-style: bold;
    transition-duration: 0.1s;
}

.button:hover {
    background-color: rgba(80, 120, 255, 1);
}

.button:active {
    background-color: rgba(50, 80, 200, 1);
}

.button-secondary {
    background-color: rgba(255, 255, 255, 0.1);
}

.button-secondary:hover {
    background-color: rgba(255, 255, 255, 0.15);
}

.button-success {
    background-color: rgba(46, 204, 113, 1);
}

.button-success:hover {
    background-color: rgba(54, 215, 122, 1);
}

.button-danger {
    background-color: rgba(231, 76, 60, 1);
}

.button-danger:hover {
    background-color: rgba(242, 89, 75, 1);
}

.player-list {
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 8px;
    padding: 10px;
    min-height: 200px;
    margin-bottom: 20px;
}

.player-entry {
    flex-direction: row;
    padding: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
    align-items: center;
}

.player-entry-text {
    color: white;
    font-size: 14px;
    flex-grow: 1;
}

.hidden {
    display: none;
}
