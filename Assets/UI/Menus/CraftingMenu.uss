.crafting-root {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.5);
    display: none;
}

.crafting-panel {
    width: 600px;
    height: 500px;
    flex-direction: row;
}

.recipe-list {
    flex-grow: 1;
    padding: var(--spacing-md);
    border-right-width: 1px;
    border-right-color: rgba(255, 255, 255, 0.1);
}

.recipe-details {
    width: 250px;
    padding: var(--spacing-md);
    align-items: center;
}

.recipe-item {
    padding: 8px;
    margin-bottom: 4px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 4px;
}

.recipe-item:hover {
    background-color: rgba(255, 255, 255, 0.15);
}

.recipe-item-selected {
    background-color: var(--color-accent);
}

.recipe-item-selected .label {
    color: black;
}

.ingredient-item {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 4px;
}

.craft-button {
    margin-top: auto;
    width: 100%;
}

.close-button {
    position: absolute;
    top: 10px;
    right: 10px;
    background-color: transparent;
    border-width: 0;
    color: white;
    font-size: 20px;
}
