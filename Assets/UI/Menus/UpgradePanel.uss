.upgrade-root {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.5);
    display: none;
}

.upgrade-panel {
    width: 450px;
    padding: var(--spacing-lg);
}

.upgrade-header {
    font-size: 24px;
    color: var(--color-accent);
    margin-bottom: var(--spacing-md);
    -unity-text-align: middle-center;
}

.upgrade-info {
    margin-bottom: var(--spacing-lg);
}

.upgrade-description {
    font-size: 16px;
    color: white;
    white-space: normal;
}

.cost-container {
    margin-top: var(--spacing-md);
    flex-direction: row;
    flex-wrap: wrap;
}

.cost-item {
    margin-right: var(--spacing-md);
    color: #ccc;
}

.upgrade-button {
    height: 40px;
}
